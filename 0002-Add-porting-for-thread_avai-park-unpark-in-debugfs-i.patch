From 9582ef3755bc2fb276de667948d7d7292eeb2e05 Mon Sep 17 00:00:00 2001
From: Tianrui Zhao <zhaotianrui@loongson.cn>
Date: Fri, 27 Mar 2026 10:37:52 +0800
Subject: [PATCH 2/3] Add porting for thread_avai/park/unpark in debugfs in
 v6.18

Signed-off-by: Tianrui Zhao <zhaotianrui@loongson.cn>
Change-Id: I6bdd5eca9fec194e68048b766fb033f51d695b97
---
 loonggpu/loonggpu_debugfs.c | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/loonggpu/loonggpu_debugfs.c b/loonggpu/loonggpu_debugfs.c
index 92329e9..a15ca39 100644
--- a/loonggpu/loonggpu_debugfs.c
+++ b/loonggpu/loonggpu_debugfs.c
@@ -639,9 +639,9 @@ static int loonggpu_debugfs_test_gfx_tl_ib(struct seq_file *m, void *data)
 	for (i = 0; i < LOONGGPU_MAX_RINGS; i++) {
 		struct loonggpu_ring *ring = adev->rings[i];
 
-		if (!ring || !ring->sched.thread)
+		if (!lg_ring_sched_thread_avai(ring))
 			continue;
-		kthread_park(ring->sched.thread);
+		lg_ring_sched_thread_park(ring);
 	}
 
 	seq_printf(m, "run gfx two level ib test:\n");
@@ -655,9 +655,9 @@ static int loonggpu_debugfs_test_gfx_tl_ib(struct seq_file *m, void *data)
 	for (i = 0; i < LOONGGPU_MAX_RINGS; i++) {
 		struct loonggpu_ring *ring = adev->rings[i];
 
-		if (!ring || !ring->sched.thread)
+		if (!lg_ring_sched_thread_avai(ring))
 			continue;
-		kthread_unpark(ring->sched.thread);
+		lg_ring_sched_thread_unpark(ring);
 	}
 
 	return 0;
-- 
2.51.0

