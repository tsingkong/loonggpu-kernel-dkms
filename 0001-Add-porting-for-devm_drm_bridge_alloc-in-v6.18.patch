From 74dceb653ce5f633d314ac59d7442789f2d66120 Mon Sep 17 00:00:00 2001
From: zhaotianrui <zhaotianrui@loongson.cn>
Date: Fri, 27 Mar 2026 09:58:20 +0800
Subject: [PATCH 1/3] Add porting for devm_drm_bridge_alloc in v6.18

Signed-off-by: zhaotianrui <zhaotianrui@loongson.cn>
Change-Id: I6503100ce615262fbde12e32ed64abae19552b59
---
 loonggpu-bridge/bridge_phy.c |  2 +-
 loonggpu-bridge/bridge_phy.h | 20 ++++++++++++++++++++
 2 files changed, 21 insertions(+), 1 deletion(-)

diff --git a/loonggpu-bridge/bridge_phy.c b/loonggpu-bridge/bridge_phy.c
index 42f8be2..082d513 100644
--- a/loonggpu-bridge/bridge_phy.c
+++ b/loonggpu-bridge/bridge_phy.c
@@ -1229,7 +1229,7 @@ struct loonggpu_bridge_phy *bridge_phy_alloc(struct loonggpu_dc_bridge *dc_bridg
 	struct connector_resource *connector_res =
 			dc_bridge->adev->dc->link_info[index].connector;
 
-	bridge_phy = kzalloc(sizeof(*bridge_phy), GFP_KERNEL);
+	bridge_phy = lg_bridge_phy_alloc(dc_bridge->adev, &bridge_funcs);
 	if (IS_ERR(bridge_phy)) {
 		DRM_ERROR("Failed to alloc loonggpu bridge phy!\n");
 		return NULL;
diff --git a/loonggpu-bridge/bridge_phy.h b/loonggpu-bridge/bridge_phy.h
index 754fb7a..3d906a7 100644
--- a/loonggpu-bridge/bridge_phy.h
+++ b/loonggpu-bridge/bridge_phy.h
@@ -306,4 +306,24 @@ const char *drm_get_edid_manufacturer(const struct edid *edid);;
 bool is_hpn_special_display(const struct edid *edid);
 bool is_eat_special_display(const struct edid *edid);
 
+static inline struct loonggpu_bridge_phy *lg_bridge_phy_alloc(struct loonggpu_device *adev,
+							const struct drm_bridge_funcs *bridge_funcs)
+{
+#if defined(devm_drm_bridge_alloc)
+	struct device *dev;
+	if (adev->loongson_dc)
+		dev = &adev->loongson_dc->dev;
+	else {
+		/* type 9a10 */
+		dev = &adev->pdev->dev;
+	}
+	return devm_drm_bridge_alloc(dev, struct loonggpu_bridge_phy, bridge, bridge_funcs);
+#else
+	struct loonggpu_bridge_phy *bridge_phy;
+
+	return kzalloc(sizeof(*bridge_phy), GFP_KERNEL);
+#endif
+}
+
+
 #endif /* __BRIDGE_PHY_H__ */
-- 
2.51.0

